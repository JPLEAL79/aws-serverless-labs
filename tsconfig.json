  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tests/**/*.ts",
    "shared/**/*.ts",
    "climate/**/*.ts",
    "order/**/*.ts",
    "user/**/*.ts"
  ]
}
